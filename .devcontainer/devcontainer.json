{
  "name": "rust-discordbot-base",
  "image": "mcr.microsoft.com/devcontainers/rust:latest",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "profile": "minimal",
      "components": "clippy,rustfmt"
    },
    "ghcr.io/devcontainers/features/direnv:1": {}
  },
  "mounts": [
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
  ],
  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "serayuzgur.crates"
      ],
      "settings": {
        "direnv.enable": true
      }
    }
  },
  "postCreateCommand": "rustup component add clippy rustfmt && cargo install cargo-watch && git config --global --add safe.directory ${containerWorkspaceFolder} && if [ -f .envrc ]; then direnv allow .; fi && cargo build"
}
